# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional. Required for OpenAI GPT-4o/4.1/o4-mini coin recognition.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# NUMISTA_API_KEY: Optional. Required for Numista coin database sync.
# Get your key at https://en.numista.com/api/doc/index.php
NUMISTA_API_KEY="MY_NUMISTA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_PASSWORD: Single shared password that unlocks AI recognition, the Services
# tab and catalog editing. If empty, those features are locked for everyone and
# the site is read-only (public catalog browsing + stats still work).
AUTH_PASSWORD=""

# AUTH_SECRET: Optional. HMAC key for signing the session cookie. If omitted it is
# derived from AUTH_PASSWORD (so changing the password logs everyone out).
AUTH_SECRET=""
