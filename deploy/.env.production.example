# Copy to /opt/numiscan/.env on the server and fill in real values.
# `.env` is gitignored - never commit the filled-in file.

NODE_ENV=production
PORT=3001
APP_URL=https://numiscan.example.com

# Login for the public mirror: this one password unlocks AI recognition,
# the Services tab and catalog editing. Leave empty = whole site read-only.
AUTH_PASSWORD=
# Optional; defaults to a value derived from AUTH_PASSWORD.
AUTH_SECRET=

# Required for Gemini recognition
GEMINI_API_KEY=

# Optional - OpenAI / GPT recognition
OPENAI_API_KEY=

# Optional - Numista specs sync
NUMISTA_API_KEY=
