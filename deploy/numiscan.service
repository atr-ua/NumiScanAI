# /etc/systemd/system/numiscan.service
# systemd unit for the NumiScan AI (GemCoin) catalog.
# Install:  sudo cp deploy/numiscan.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now numiscan

[Unit]
Description=NumiScan AI (GemCoin) coin catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=numiscan
Group=numiscan
WorkingDirectory=/opt/numiscan
EnvironmentFile=/opt/numiscan/.env
Environment=NODE_ENV=production
Environment=PORT=3001

# `which node` on the server and adjust if it is /usr/local/bin/node (nvm / tarball install).
ExecStart=/usr/bin/node dist/server.cjs

Restart=on-failure
RestartSec=3
# SQLite checkpoints the WAL on the next start; give it room to exit cleanly anyway.
TimeoutStopSec=30

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/numiscan

[Install]
WantedBy=multi-user.target
